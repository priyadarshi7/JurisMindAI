# TradeGraph — required environment variables.
#
# This file documents every variable the application reads. It carries NO VALUES
# (docs/11-security-and-safety.md, docs/12-infrastructure-and-deployment.md §12/§15).
# Real values come only from managed secret/environment configuration in each
# environment (development / staging / production) — never committed here,
# never baked into a Docker image.

# --- Environment -------------------------------------------------------------
ENVIRONMENT=
# One of: development | staging | production  (docs/12)

# --- API -----------------------------------------------------------------
API_HOST=
API_PORT=
CORS_ALLOWED_ORIGINS=

# --- Auth (D-11 — JWT + multi-tenant) -------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=

# --- PostgreSQL (system of record; D-7 evidence graph; D-10 checkpointer) --
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DATABASE_URL=
# postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# --- Redis (cache layers; D-8 Celery broker; rate limiting) ---------------
REDIS_HOST=
REDIS_PORT=
REDIS_DB=
REDIS_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Qdrant (dense + D-3 native sparse retrieval) --------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# --- Neo4j — citation knowledge graph (NyayaGraph pivot) -------------------
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Object storage — MinIO / S3-compatible --------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET_RAW_DOCUMENTS=
S3_BUCKET_MARKET_DATA=
# S3_BUCKET_MARKET_DATA: Parquet/bulk historical data (D-6)

# --- Ollama — local LLM + embedding serving (D-1, D-2, D-30) ---------------
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=
OLLAMA_EMBEDDING_DIMENSION=
# Pin before creating the Qdrant collection — changing this invalidates every vector.
OLLAMA_CHAT_MODEL=
# Single model the V1 linear pipeline uses for every node (see src/core/config.py).

# Per-node model tiering (D-1). Pin by tag; digest recorded in ops/ollama/ modelfiles.
OLLAMA_MODEL_PLANNER=
OLLAMA_MODEL_QUERY_REWRITER=
OLLAMA_MODEL_EVIDENCE_EXTRACTOR=
OLLAMA_MODEL_VERIFIER=
OLLAMA_MODEL_CRITIC=
OLLAMA_MODEL_SYNTHESIZER=
OLLAMA_MODEL_CITATION_VALIDATOR=

# --- Reranker — own serving path, NOT Ollama (D-30) ------------------------
RERANKER_BASE_URL=
RERANKER_MODEL=

# --- MCP (D-9, D-29) --------------------------------------------------------
MCP_TRANSPORT=
# stdio (development) | http (production, co-located/private only)
MCP_QUANT_SERVER_URL=
MCP_MARKET_DATA_SERVER_URL=

# --- LangSmith — AI/agent tracing + experimentation (§11; D-25 exp. only) --
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_ENDPOINT=

# --- OpenTelemetry — application/infra tracing -----------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Prometheus (D-31) -------------------------------------------------------
PROMETHEUS_METRICS_PORT=

# --- Guardrails — tunable defaults (D-21) -----------------------------------
MAX_RESEARCH_ITERATIONS=
MAX_TOOL_CALLS_PER_JOB=
MAX_PARALLEL_RESEARCH_BRANCHES=
MAX_LLM_CALLS_PER_JOB=

# --- Cache TTLs — tunable defaults (D-24) -----------------------------------
CACHE_TTL_EMBEDDINGS_DAYS=
CACHE_TTL_RETRIEVAL_HOURS=
CACHE_TTL_LLM_HOURS=

# --- Cost imputation (D-1, D-26 — no per-token invoice on a self-hosted model)
IMPUTED_COST_RATE_PER_1K_TOKENS=
